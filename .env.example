# ---------------------------------------------------------------------------
# CTA content fragment source configuration
#
# These defaults mirror the ACCA EDS `content-fragment` block. Copy this file
# to `.env.local` and fill in your own AEM publish host to fetch live data.
# ---------------------------------------------------------------------------

# The AEM publish origin that hosts the GraphQL persisted query endpoint.
# Leave blank to run the app in MOCK mode (renders a sample CTA fragment).
AEM_PUBLISH_ORIGIN=https://publish-p147324-e2050468.adobeaemcloud.com

# Persisted GraphQL query path used to fetch a CTA fragment by path.
# This matches the query the EDS content-fragment block uses.
AEM_GRAPHQL_QUERY=/graphql/execute.json/ref-demo-eds/CTAByPath

# Adobe I/O Runtime wrapper service that proxies the GraphQL request so a
# browser / third-party app can call it without hitting CORS. This is the same
# gateway the EDS block posts to on publish.
CF_WRAPPER_SERVICE_URL=https://3635370-refdemoapigateway-stage.adobeioruntime.net/api/v1/web/ref-demo-api-gateway/fetch-cf

# Default content fragment path to load on first page render.
DEFAULT_CF_PATH=/content/dam/mandg/en/fragments/promotions/fragment-one

# Default variation (leave as "master" unless you author variations).
DEFAULT_CF_VARIATION=master
